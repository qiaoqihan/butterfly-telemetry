# 复制为 .env 后填入真实密钥（.env 已被 .gitignore 忽略，不会被提交）
# 也可不创建本地 .env，仅在 Vercel Dashboard 设置环境变量

# 豆包 / 火山方舟 API Key（必填，Pro 版豆包识别功能依赖此变量）
DOUBAO_API_KEY=your_doubao_api_key_here

# 豆包服务地址（默认即火山方舟北京区，无需修改）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 视觉模型 ID（在火山方舟控制台创建模型推理接入点后获取，例如 ep-xxxxxxxx）
DOUBAO_MODEL=ep-xxxxxxxx
# 生产域名（用于后端校验同源请求，可选；留空则只允许 Vercel 默认域名）
PROD_URL=https://your-domain.vercel.app
